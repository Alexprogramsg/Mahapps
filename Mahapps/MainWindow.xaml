<mah:MetroWindow x:Class="Mahapps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mahapps"
        mc:Ignorable="d"
        TitleCharacterCasing="Normal"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        Icon="/Assets/Images/cash.ico"
        ResizeMode="CanResizeWithGrip"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="5"
        Title="MyBudget" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28px"/>
        </Grid.RowDefinitions>


        <StatusBar Grid.Row="1">
            <StatusBarItem FontSize="16">Remaining  Monthly Budget</StatusBarItem>
            <StatusBarItem>
                <TextBlock FontSize="16" Text="{Binding RemainingBalance}"></TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
